# BookMyShow Environment Configuration Template
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bookmyshow
MYSQL_CONNECTION_LIMIT=20

# Redis Distributed Cache & Mutex Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Business & Concurrency Rules
SEAT_LOCK_TTL_SECONDS=600
SWEEPER_INTERVAL_MS=5000
MAX_SEATS_PER_BOOKING=10
CONVENIENCE_FEE_RATE=0.18
BASE_CONVENIENCE_FEE_CENTS=3000

# Security & B2B Partner API Gateway
JWT_SECRET=your_jwt_secret_here
ADMIN_SECRET_KEY=your_admin_secret_key_here
DEFAULT_PARTNER_RATE_LIMIT_RPM=120
HMAC_MAX_CLOCK_SKEW_SECONDS=300
